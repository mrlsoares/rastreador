                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Dispositivo removido com sucesso"
                    },
                    "404": {
                        "description": "Dispositivo não encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/esp32/dispositivos/{identificador}/regenerar-token": {
            "post": {
                "tags": [
                    "ESP32 - Dispositivos"
                ],
                "summary": "Gera um novo token de ingestão para o dispositivo (revoga o anterior)",
                "operationId": "0ce595021e8a9d0a98b542ff84aeae52",
                "parameters": [
                    {
                        "name": "identificador",
                        "in": "path",
                        "description": "MAC Address ou ID do dispositivo",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Novo token gerado (exibido uma única vez)"
                    },
                    "404": {
                        "description": "Dispositivo não encontrado"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/v1/esp32/provision": {
            "post": {
                "tags": [
                    "ESP32 - Dispositivos"
                ],
                "summary": "Auto-provisionamento: o dispositivo obtém seu token de ingestão",
                "description": "Máquina-a-máquina. Autenticado pela chave de bootstrap (X-API-KEY). O dispositivo precisa estar pré-cadastrado e ativo. Gera e devolve um token novo (revoga o anterior), exibido uma única vez.",
                "operationId": "1a8a95c7bae3efd5ca366f875c120319",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "identificador"
                                ],
                                "properties": {
                                    "identificador": {
                                        "type": "string",
                                        "example": "AA:BB:CC:DD:EE:FF"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token provisionado (exibido uma única vez)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Token provisionado."
                                        },
                                        "device_token": {
                                            "type": "string",
                                            "example": "aBc123...48chars"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "X-API-KEY ausente ou inválida"
                    },
                    "403": {
                        "description": "Dispositivo inativo"
                    },
                    "404": {
                        "description": "Dispositivo não cadastrado"
                    },
                    "422": {
                        "description": "identificador ausente"
                    }
                },
                "security": [
                    {
                        "apiKeyAuth": []
                    }
                ]
            }
        },
        "/api/v1/esp32/telemetry": {
            "post": {
                "tags": [
                    "ESP32"
                ],
                "summary": "Recebe e processa dados de telemetria de uma placa ESP32",
                "description": "Ingestão autenticada por token de dispositivo (header X-DEVICE-TOKEN). O dispositivo deve estar pré-cadastrado e ativo — não há criação automática. Token ausente/inválido/revogado ou dispositivo inativo retornam 401. Provisione o token via /esp32/provision (máquina-a-máquina) ou pelo app.",
                "operationId": "4e11f793b4dc03072b6fca9b20f7c082",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "identificador"
                                ],
                                "properties": {
                                    "identificador": {
                                        "description": "MAC Address ou ID único do chip",
                                        "type": "string",
                                        "example": "AA:BB:CC:DD:EE:FF"
                                    },
                                    "nome": {
                                        "description": "Nome amigável do dispositivo",
                                        "type": "string",
                                        "example": "ESP32-Caminhão-01"
                                    },
                                    "lat": {
                                        "type": "number",
                                        "format": "float",
                                        "example": -23.55052
                                    },
                                    "lon": {
                                        "type": "number",
                                        "format": "float",
                                        "example": -46.6333
                                    },
                                    "bateria": {
                                        "description": "Voltagem da bateria (V)",
                                        "type": "number",
                                        "format": "float",
                                        "example": 3.85
                                    },
                                    "temp": {
                                        "description": "Temperatura em °C",
                                        "type": "number",
                                        "format": "float",
                                        "example": 34.5
                                    },
                                    "vel": {
                                        "description": "Velocidade em km/h",
                                        "type": "integer",
                                        "example": 60
                                    },
                                    "timestamp": {
                                        "description": "Data/hora do dispositivo (opcional, usa now() se omitido)",
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-05-03T20:00:00Z"
                                    },
                                    "extra": {
                                        "description": "Payload extra em JSON livre",
                                        "type": "object",
                                        "example": {
                                            "sinal_gsm": -75
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Telemetria processada com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "401": {
                        "description": "X-DEVICE-TOKEN ausente/inválido/revogado ou dispositivo inativo",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "422": {
                        "description": "Dados inválidos",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    },
                    "500": {
                        "description": "Erro interno",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                },
                "security": [
                    {
                        "deviceToken": []
                    }
                ]
            }
        },
