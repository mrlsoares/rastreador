                                        "type": "string",
                                        "example": "Sensor Atualizado"
                                    },
                                    "descricao": {
                                        "type": "string",
                                        "example": "Localização: Galpão B"
                                    },
                                    "ativo": {
                                        "type": "boolean",
                                        "example": false
                                    }
