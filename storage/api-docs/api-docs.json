                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "ESP32 - Dispositivos"
                ],
                "summary": "Atualiza os dados cadastrais de um dispositivo ESP32",
                "operationId": "356ced5cde9f6a5ff3eb50761d062a8e",
                "parameters": [
                    {
                        "name": "identificador",
                        "in": "path",
                        "description": "MAC Address ou ID do dispositivo",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
